# ---- API ----
APP_ENV=local                 # local | demo | production
DATABASE_URL=postgresql+psycopg://sentinelflow:sentinelflow@localhost:5432/sentinelflow
# For quick local demos without Postgres:
# DATABASE_URL=sqlite:///./sentinelflow.db

# Required in production: 32+ random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Comma-separated browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
LOGIN_RATE_LIMIT=10

# worker: the worker process runs workflows | inline: the API runs them itself
WORKFLOW_EXECUTION=worker

# AI triage: deterministic (built-in playbook) or gemini
AI_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Worker ----
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=20

# ---- Dashboard (apps/web) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
